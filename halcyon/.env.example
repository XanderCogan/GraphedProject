# Local development database (docker compose up -d).
# In Graphed cloud, DATABASE_URL is injected from databases.primary — see graphed.yaml.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# Warehouse schema the Graphed Postgres connector assigned to the Halcyon tables
# (graphed sources list). Set in the cloud with: graphed secrets set WAREHOUSE_SCHEMA
WAREHOUSE_SCHEMA=halcyon
