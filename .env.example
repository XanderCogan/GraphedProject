# Supabase Postgres connection string (Session pooler, IPv4). Never commit the real one.
# Use the pooler, not db.<ref>.supabase.co: the direct host is IPv6-only. This project is in us-east-2.
# Supabase dashboard -> Connect -> Session pooler -> copy URI, paste password in.
SUPABASE_DB_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-us-east-2.pooler.supabase.com:5432/postgres
